{
  "name": "@unlocalhosted/pele-rs",
  "version": "0.3.0",
  "description": "Pele-compatible diagram rendering through independent Rust and WebAssembly",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vijayksingh/pele-rs.git",
    "directory": "bindings/web"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./pele.wasm": "./pkg/pele_bg.wasm",
    "./core": {
      "types": "./core.d.ts",
      "import": "./core.js"
    },
    "./full": {
      "types": "./full.d.ts",
      "import": "./full.js"
    },
    "./registry": {
      "types": "./registry.d.ts",
      "import": "./registry.js"
    },
    "./lazy": {
      "types": "./lazy.d.ts",
      "import": "./lazy.js"
    },
    "./diagrams": {
      "types": "./diagram-entries.d.ts",
      "import": "./diagram-entries.js"
    },
    "./diagrams/*": {
      "types": "./diagrams/*.d.ts",
      "import": "./diagrams/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "pkg/",
    "LICENSE",
    "NOTICE",
    "PELE-LICENSE",
    "FONT-OFL.txt",
    "README.md",
    "core.js",
    "core.d.ts",
    "MERMAID-LICENSE",
    "V8-LICENSE",
    "FDLIBM-LICENSE",
    "full.js",
    "full.d.ts",
    "resources.js",
    "graph.js",
    "graph-storage.js",
    "host-er-store.js",
    "errors.js",
    "graph-binary.js",
    "render-numbers.js",
    "mount.js",
    "zoom.js",
    "window.js",
    "registry.js",
    "registry.d.ts",
    "lazy.js",
    "lazy.d.ts",
    "parse-limits.js",
    "REGISTRY.md",
    "diagram-entries.js",
    "diagram-entries.d.ts",
    "diagrams/",
    "builtin-entries.js",
    "all-diagram-entries.js",
    "host-functions.js",
    "initialize.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
